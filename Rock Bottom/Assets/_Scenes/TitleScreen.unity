MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1880137979}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: da68490a23927964c9ba96db491752b3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InstructionUI
  pages:
  - title: Introduction
    content: "Welcome to the mining adventure!\r\n\r\nDig your way through the underground,
      collect valuable ores, and manage your Oil wisely. \r\nEach dig costs Oil but
      earns Money depending on the block type.\r\n\r\nYour journey continues deeper
      and deeper until you reach the Rock Bottom."
  - title: Controls
    content: 'A: Move Left

      S: Move Down

      D: Move Rigtt

      Digging
      consumes Oil and earns Money.

'
  - title: Block Types
    content: 'Dirt: Low value

      Iron: Medium value

      Gold: High value

      Rock:
      Cannot be mined

      Oil: Refills your Oil'
  - title: Bomb System
    content: 'Use Bomb to enter bomb mode.

      Click a block to destroy it.

      Bombs
      destroy any block, including Rocks.

      Destroyed blocks give no Money and
      no Oil.'
  - title: Game Over
    content: 'Game ends when Oil reaches 0.

      You may click End Game to finish
      manually.'
  - title: Upgrades
    content: 'Lager Fuel Tank: increases max Oil.

      Refined Ores: increases
      Money gained.

      Power Drill: reduces Oil consumption.

      Restock Bombs:
      refills bombs to max.'
  titleText: {fileID: 259132142}
  contentText: {fileID: 314765419}
  prevButton: {fileID: 1296526893}
  nextButton: {fileID: 1622661759}
